# Copy to backend/.env. Every setting is optional.

# Where uploads, Parquet files and the SQLite metadata DB live
# SLA_DATA_DIR=../data
# SLA_DATABASE_URL=sqlite:///../data/app.db

# Fernet key used to encrypt provider API keys at rest.
# If unset, one is generated into $SLA_DATA_DIR/.secret_key on first start.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SLA_FERNET_KEY=

# Upload limit in MB
# SLA_MAX_UPLOAD_MB=500

# Comma-separated origins allowed to call the API (the Vite dev server by default)
# SLA_CORS_ORIGINS=http://localhost:5173

# SLA_LOG_LEVEL=INFO
# SLA_LOG_JSON=true
